<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Run a real PostgreSQL server (with extensions) embedded in .NET applications and tests on Windows, Linux and macOS.</Description>
    <Copyright>Copyright (C) Babu Annamalai</Copyright>
    <AssemblyTitle>MysticMind.PostgresEmbed</AssemblyTitle>
    <VersionPrefix>5.3.0</VersionPrefix>
    <Authors>Babu Annamalai</Authors>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>MysticMind.PostgresEmbed</AssemblyName>
    <RootNamespace>MysticMind.PostgresEmbed</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>MysticMind.PostgresEmbed</PackageId>
    <PackageTags>postgres;postgresql;pg;embed;embedded;server;testing;integration-tests</PackageTags>
    <PackageProjectUrl>https://github.com/mysticmind/mysticmind-postgresembed</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/mysticmind/mysticmind-postgresembed</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PackageReadmePath)" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- nuget.org shows raw HTML as text, so the packed README leaves out the HTML logo above the title (nuget.org
       shows the package icon there); the rest is the repository README unchanged -->
  <PropertyGroup>
    <PackageReadmePath>$(BaseIntermediateOutputPath)package-readme/README.md</PackageReadmePath>
  </PropertyGroup>

  <Target Name="WritePackageReadme" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <WritePackageReadme Source="$(MSBuildThisFileDirectory)../../README.md" Destination="$(PackageReadmePath)" />
  </Target>

  <!-- an inline task, not WriteLinesToFile: MSBuild turns backslashes in lines into slashes outside Windows -->
  <UsingTask TaskName="WritePackageReadme" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = File.ReadAllText(Source);
        if (text.StartsWith("<img ")) text = text.Substring(text.IndexOf("# "));
        if (text.Contains("<img ") || text.Contains("<a "))
        {
            Log.LogError("README.md has HTML that nuget.org shows as text; use Markdown");
            return false;
        }
        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(Destination)));
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != text) File.WriteAllText(Destination, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <InternalsVisibleTo Include="MysticMind.PostgresEmbed.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Polly.Core" Version="8.9.0" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
  </ItemGroup>
</Project>
