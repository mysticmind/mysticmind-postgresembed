<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Run a real PostgreSQL server (with extensions) embedded in .NET applications and tests on Windows, Linux and macOS.</Description>
    <Copyright>Copyright (C) Babu Annamalai</Copyright>
    <AssemblyTitle>MysticMind.PostgresEmbed</AssemblyTitle>
    <VersionPrefix>5.2.1</VersionPrefix>
    <Authors>Babu Annamalai</Authors>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyName>MysticMind.PostgresEmbed</AssemblyName>
    <RootNamespace>MysticMind.PostgresEmbed</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>MysticMind.PostgresEmbed</PackageId>
    <PackageTags>postgres;postgresql;pg;embed;embedded;server;testing;integration-tests</PackageTags>
    <PackageProjectUrl>https://github.com/mysticmind/mysticmind-postgresembed</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mysticmind/mysticmind-postgresembed</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MysticMind.PostgresEmbed.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Polly.Core" Version="8.9.0" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
  </ItemGroup>
</Project>
